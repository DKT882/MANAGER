# Telegram Bot Token obtained from @BotFather (Required)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# MongoDB Connection Configuration (Optional - falls back to local in-memory if empty)
# For remote MongoDB Atlas on Render, zlib compression and connection pooling are auto-configured
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=telegram_admin_bot

# Render Cloud Deployment Settings
PORT=10000
SERVICE_NAME=BioLinkChannelRestrictorBot
SUPPORT_URL=https://t.me/your_support_channel_or_group
PYTHONUNBUFFERED=1
MALLOC_TRIM_THRESHOLD_=100000
MALLOC_ARENA_MAX=2
